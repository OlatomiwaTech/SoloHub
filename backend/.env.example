# Copy this file to .env in the backend directory and replace credentials.
# Local PostgreSQL example; change username, password, host, and database as needed.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/solohub?schema=public"

# Local API settings
PORT=5000
APP_URL=http://localhost:5173

# Generate a unique value for your own .env with: openssl rand -hex 32
# This example value is for local development only. Never use it in production.
JWT_SECRET=dev-only-change-this-before-deploying-9d3166b218254e0b8523b58154f7a1b9
JWT_EXPIRY=7d

# Needed only when enabling the server-side Paystack payment flow.
# Get test credentials from your Paystack dashboard; never use live keys locally.
PAYSTACK_SECRET_KEY=sk_test_replace_with_your_paystack_test_secret_key

# Optional SMTP settings for invoice and payment emails.
# For Gmail, use an app password rather than your normal account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=replace-with-your-sender-email
EMAIL_PASSWORD=replace-with-your-email-app-password
EMAIL_FROM=noreply@solohub.app
