# Copy this file to .env in the frontend directory.
# Use the local API while running the backend on your computer.
VITE_API_URL=http://localhost:5000/api

# Paystack public key is safe to expose in the browser, but still use a test key locally.
# Get the real test key from your Paystack dashboard.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_replace_with_your_paystack_test_public_key
